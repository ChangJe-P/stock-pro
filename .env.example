# 이 파일을 .env로 복사해 로컬 개발에만 사용한다. .env는 Git에 커밋하지 않는다.
# 애플리케이션 접속 설정
# FRONTEND_PORT: 브라우저 공개 포트, BACKEND_PORT: 컨테이너 내부 Django 포트.
# 화면과 JSON API는 같은 origin(기본 http://localhost:3000)에서 제공된다.
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Django 설정. SECRET_KEY는 로컬 개발용 무작위 문자열을 .env에만 넣는다(예시 값 금지).
# ALLOWED_HOSTS는 쉼표로 구분한다.
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 로컬 개발 설정
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jumong
POSTGRES_USER=jumong_app
POSTGRES_PASSWORD=replace-with-a-local-password

# 시장 데이터 제공처. T-002에서 승인된 값은 pykrx뿐이다.
# pykrx는 API 키·endpoint·요청 제한이 필요 없으므로 아래 값들은 비워 둔다.
# provider가 비어 있거나 pykrx가 아니면 수집은 외부 요청 없이 안전하게 실패한다.
MARKET_DATA_PROVIDER=pykrx
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_REQUESTS_PER_MINUTE=

# 가상 거래 정책(T-003, 학습용 시뮬레이션 v1). 실제 수수료·세율이 아니다.
# 값은 계좌 최초 생성 시 스냅샷으로 저장되며, 이후 값을 바꿔도 기존 계좌에는 소급 적용되지 않는다.
# 모든 금액은 KRW 정수, 비율은 0 이상 1 미만, 슬리피지는 0 이상 정수다.
VIRTUAL_INITIAL_CASH_KRW=10000000
VIRTUAL_BUY_FEE_RATE=0.00015
VIRTUAL_SELL_FEE_RATE=0.00015
VIRTUAL_SELL_TAX_RATE=0
VIRTUAL_SLIPPAGE_BPS=0
VIRTUAL_TRADING_POLICY_VERSION=v1

# Notion 내보내기 기능을 구현할 때만 입력한다.
# Notion Internal connection의 설치 액세스 토큰을 입력한다.
NOTION_INTEGRATION_TOKEN=
NOTION_DAILY_REPORT_DATA_SOURCE_ID=
NOTION_CODE_REVIEW_DATA_SOURCE_ID=
NOTION_WORK_ITEM_DATA_SOURCE_ID=
NOTION_PROMPT_RUN_DATA_SOURCE_ID=
