# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
FRONTEND_PORT=3000
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jumong
POSTGRES_USER=jumong_app
POSTGRES_PASSWORD=replace-with-a-local-password

# Set only after the data provider and its terms are approved.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# Set only when the Notion export feature is implemented.
NOTION_API_KEY=
NOTION_DAILY_REPORT_DATA_SOURCE_ID=
NOTION_CODE_REVIEW_DATA_SOURCE_ID=
NOTION_WORK_ITEM_DATA_SOURCE_ID=
NOTION_PROMPT_RUN_DATA_SOURCE_ID=
